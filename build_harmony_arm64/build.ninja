  COMMAND = cmd.exe /C "cd /D F:\MyProject\vintage-pomelo\xsystem4\build_harmony_arm64\subprojects\cglm && C:\Strawberry\c\bin\cmake.exe -DCMAKE_INSTALL_DO_STRIP=1 -P cmake_install.cmake"
  DESC = Installing the project stripped...
  pool = console
  restat = 1

build subprojects/cglm/install/strip: phony subprojects/cglm/CMakeFiles/install/strip.util

